   "text": "înscriere",
   "rate": "-10%"
  },
  {
   "file": "u1-s.mp3",
   "text": "Îi scriu o scrisoare bunicii.",
   "rate": "+0%"
  },
  {
   "file": "u1-s-slow.mp3",
   "text": "Îi scriu o scrisoare bunicii.",
   "rate": "-35%"
  },
  {
   "file": "u1-t.mp3",
   "text": "Salut! Te-ai înscris la cursul de română? Eu m-am înscris ieri. Scrie-mi diseară!",
   "rate": "-5%"
  },
  {
   "file": "u2-w1.mp3",
   "text": "a citi",
   "rate": "-10%"
  },
  {
   "file": "u2-w2.mp3",
   "text": "cititor",
   "rate": "-10%"
  },
  {
   "file": "u2-w3.mp3",
   "text": "citire",
   "rate": "-10%"
  },
  {
   "file": "u2-w4.mp3",
   "text": "cititoare",
   "rate": "-10%"
  },
  {
   "file": "u2-w5.mp3",
   "text": "recitire",
   "rate": "-10%"
  },
  {
   "file": "u2-s.mp3",
   "text": "Îmi place să citesc seara.",
   "rate": "+0%"
  },
  {
   "file": "u2-s-slow.mp3",
   "text": "Îmi place să citesc seara.",
   "rate": "-35%"
  },
  {
   "file": "u2-t.mp3",
   "text": "Biblioteca orașului. Sala de lectură: de la nouă la nouăsprezece. Duminică: închis. Vă rugăm să returnați cărțile la timp!",
   "rate": "-5%"
  },
  {
   "file": "u3-w1.mp3",
   "text": "a lucra",
   "rate": "-10%"
  },
  {
   "file": "u3-w2.mp3",
   "text": "lucru",
   "rate": "-10%"
  },
  {
   "file": "u3-w3.mp3",
   "text": "lucrare",
   "rate": "-10%"
  },
  {
   "file": "u3-w4.mp3",
   "text": "lucrător",
   "rate": "-10%"
  },
  {
   "file": "u3-w5.mp3",
   "text": "prelucrare",
   "rate": "-10%"
  },
  {
   "file": "u3-s.mp3",
   "text": "Lucrez într-o cafenea în centru.",
   "rate": "+0%"
  },
  {
   "file": "u3-s-slow.mp3",
   "text": "Lucrez într-o cafenea în centru.",
   "rate": "-35%"
  },
  {
   "file": "u3-t.mp3",
   "text": "Angajăm! Lucrător în cafenea, program flexibil. Salariu bun. Experiența nu este necesară.",
   "rate": "-5%"
  },
  {
   "file": "u4-w1.mp3",
   "text": "a mânca",
   "rate": "-10%"
  },
  {
   "file": "u4-w2.mp3",
   "text": "mâncare",
   "rate": "-10%"
  },
  {
   "file": "u4-w3.mp3",
   "text": "mâncarea",
   "rate": "-10%"
  },
  {
   "file": "u4-w4.mp3",
   "text": "mâncăruri",
   "rate": "-10%"
  },
  {
   "file": "u4-w5.mp3",
   "text": "mâncăcios",
   "rate": "-10%"
  },
  {
   "file": "u4-s.mp3",
   "text": "Mâncarea de aici e foarte bună.",
   "rate": "+0%"
  },
  {
   "file": "u4-s-slow.mp3",
   "text": "Mâncarea de aici e foarte bună.",
   "rate": "-35%"
  },
  {
   "file": "u4-t.mp3",
   "text": "Cantina „La bunica”. Prânz: de la douăsprezece la cincisprezece. Meniul zilei: ciorbă, sarmale, papanași. Mâncare la pachet — da!",
   "rate": "-5%"
  },
  {
   "file": "u5-w1.mp3",
   "text": "a vinde",
   "rate": "-10%"
  },
  {
   "file": "u5-w2.mp3",
   "text": "vânzare",
   "rate": "-10%"
  },
  {
   "file": "u5-w3.mp3",
   "text": "vânzător",
   "rate": "-10%"
  },
  {
   "file": "u5-w4.mp3",
   "text": "vânzătoare",
   "rate": "-10%"
  },
  {
   "file": "u5-w5.mp3",
   "text": "revânzare",
   "rate": "-10%"
  },
  {
   "file": "u5-s.mp3",
   "text": "Vânzătoarea vinde flori la piață.",
   "rate": "+0%"
  },
  {
   "file": "u5-s-slow.mp3",
   "text": "Vânzătoarea vinde flori la piață.",
   "rate": "-35%"
  },
  {
   "file": "u5-t.mp3",
   "text": "De vânzare. Bicicletă aproape nouă. Preț: cinci sute de lei. Sunați după ora optsprezece.",
   "rate": "-5%"
  },
  {
   "file": "u6-w1.mp3",
   "text": "a învăța",
   "rate": "-10%"
  },
  {
   "file": "u6-w2.mp3",
   "text": "învățătoare",
   "rate": "-10%"
  },
  {
   "file": "u6-w3.mp3",
   "text": "învățătură",
   "rate": "-10%"
  },
  {
   "file": "u6-w4.mp3",
   "text": "învățământ",
   "rate": "-10%"
  },
  {
   "file": "u6-w5.mp3",
   "text": "neînvățat",
   "rate": "-10%"
  },
  {
   "file": "u6-s.mp3",
   "text": "Învăț limba română de un an.",
   "rate": "+0%"
  },
  {
   "file": "u6-s-slow.mp3",
   "text": "Învăț limba română de un an.",
   "rate": "-35%"
  },
  {
   "file": "u6-t.mp3",
   "text": "Dragi părinți, mâine elevii clasei a cincea învață despre plante în Grădina Botanică. Ne întâlnim la ora nouă în fața școlii.",
   "rate": "-5%"
  },
  {
   "file": "u7-w1.mp3",
   "text": "a cumpăra",
   "rate": "-10%"
  },
  {
   "file": "u7-w2.mp3",
   "text": "cumpărător",
   "rate": "-10%"
  },
  {
   "file": "u7-w3.mp3",
   "text": "cumpărături",
   "rate": "-10%"
  },
  {
   "file": "u7-w4.mp3",
   "text": "cumpărare",
   "rate": "-10%"
  },
  {
   "file": "u7-w5.mp3",
   "text": "cumpărat",
   "rate": "-10%"
  },
  {
   "file": "u7-s.mp3",
   "text": "Mama cumpără pâine și lapte.",
   "rate": "+0%"
  },
  {
   "file": "u7-s-slow.mp3",
   "text": "Mama cumpără pâine și lapte.",
   "rate": "-35%"
  },
  {
   "file": "u7-t.mp3",
   "text": "Lista de cumpărături: pâine, lapte, ouă, mere. Nu uita: cumpără și flori pentru bunica!",
   "rate": "-5%"
  },
  {
   "file": "u8-w1.mp3",
   "text": "a călători",
   "rate": "-10%"
  },
  {
   "file": "u8-w2.mp3",
   "text": "călătorie",
   "rate": "-10%"
  },
  {
   "file": "u8-w3.mp3",
   "text": "călător",
   "rate": "-10%"
  },
  {
   "file": "u8-w4.mp3",
   "text": "călătoria",
   "rate": "-10%"
  },
  {
   "file": "u8-w5.mp3",
   "text": "călătorii",
   "rate": "-10%"
  },
  {
   "file": "u8-s.mp3",
   "text": "Mâine călătorim cu trenul la Brașov.",
   "rate": "+0%"
  },
  {
   "file": "u8-s-slow.mp3",
   "text": "Mâine călătorim cu trenul la Brașov.",
   "rate": "-35%"
  },
  {
   "file": "u8-t.mp3",
   "text": "Gara de Nord. Tren București — Brașov. Plecare la ora șapte și cincisprezece, linia trei. Sosire la ora nouă și cincizeci. Călători, vă dorim drum bun!",
   "rate": "-5%"
  },
  {
   "file": "u9-w1.mp3",
   "text": "a juca",
   "rate": "-10%"
  },
  {
   "file": "u9-w2.mp3",
   "text": "joc",
   "rate": "-10%"
  },
  {
   "file": "u9-w3.mp3",
   "text": "jucărie",
   "rate": "-10%"
  },
  {
   "file": "u9-w4.mp3",
   "text": "jucător",
   "rate": "-10%"
  },
  {
   "file": "u9-w5.mp3",
   "text": "jucăuș",
   "rate": "-10%"
  },
  {
   "file": "u9-s.mp3",
   "text": "Copiii se joacă în parc cu mingea.",
   "rate": "+0%"
  },
  {
   "file": "u9-s-slow.mp3",
   "text": "Copiii se joacă în parc cu mingea.",
   "rate": "-35%"
  },
  {
   "file": "u9-t.mp3",
   "text": "Magazin de jucării. Reduceri la jocuri de societate: minus treizeci la sută. Deschis zilnic, de la zece la douăzeci.",
   "rate": "-5%"
  },
  {
   "file": "u10-w1.mp3",
   "text": "a dormi",
   "rate": "-10%"
  },
  {
   "file": "u10-w2.mp3",
   "text": "dormitor",
   "rate": "-10%"
  },
  {
   "file": "u10-w3.mp3",
   "text": "dormit",
   "rate": "-10%"
  },
  {
   "file": "u10-w4.mp3",
   "text": "a adormi",
   "rate": "-10%"
  },
  {
   "file": "u10-w5.mp3",
   "text": "adormit",
   "rate": "-10%"
  },
  {
   "file": "u10-s.mp3",
   "text": "Bebelușul doarme în dormitor.",
   "rate": "+0%"
  },
  {
   "file": "u10-s-slow.mp3",
   "text": "Bebelușul doarme în dormitor.",
   "rate": "-35%"
  },
  {
   "file": "u10-t.mp3",
   "text": "De închiriat. Apartament cu două dormitoare. Aproape de metrou. Preț: patru sute de euro pe lună.",
   "rate": "-5%"
  },
  {
   "file": "u11-w1.mp3",
   "text": "a închide",
   "rate": "-10%"
  },
  {
   "file": "u11-w2.mp3",
   "text": "închis",
   "rate": "-10%"
  },
  {
   "file": "u11-w3.mp3",
   "text": "a deschide",
   "rate": "-10%"
  },
  {
   "file": "u11-w4.mp3",
   "text": "deschis",
   "rate": "-10%"
  },
  {
   "file": "u11-w5.mp3",
   "text": "deschidere",
   "rate": "-10%"
  },
  {
   "file": "u11-s.mp3",
   "text": "Magazinul se deschide la ora nouă.",
   "rate": "+0%"
  },
  {
   "file": "u11-s-slow.mp3",
   "text": "Magazinul se deschide la ora nouă.",
   "rate": "-35%"
  },
  {
   "file": "u11-t.mp3",
   "text": "Închis pentru renovare. Redeschidere: luni, trei martie. Ne cerem scuze!",
   "rate": "-5%"
  },
  {
   "file": "u12-w1.mp3",
   "text": "a vorbi",
   "rate": "-10%"
  },
  {
   "file": "u12-w2.mp3",
   "text": "vorbă",
   "rate": "-10%"
  },
  {
   "file": "u12-w3.mp3",
   "text": "vorbitor",
   "rate": "-10%"
  },
  {
   "file": "u12-w4.mp3",
   "text": "vorbire",
   "rate": "-10%"
  },
  {
   "file": "u12-w5.mp3",
   "text": "vorbăreț",
   "rate": "-10%"
  },
  {
   "file": "u12-s.mp3",
   "text": "Vorbești românește? Da, puțin.",
   "rate": "+0%"
  },
  {
   "file": "u12-s-slow.mp3",
   "text": "Vorbești românește? Da, puțin.",
   "rate": "-35%"
  },
  {
   "file": "u12-t.mp3",
   "text": "Curs de română pentru nevorbitori de limba română. Vorbim de la prima lecție! Marți și joi, la ora optsprezece.",
   "rate": "-5%"
  },
  {
   "file": "u13-w1.mp3",
   "text": "a sosi",
   "rate": "-10%"
  },
  {
   "file": "u13-w2.mp3",
   "text": "sosire",
   "rate": "-10%"
  },
  {
   "file": "u13-w3.mp3",
   "text": "sosit",
   "rate": "-10%"
  },
  {
   "file": "u13-w4.mp3",
   "text": "nou-sosit",
   "rate": "-10%"
  },
  {
   "file": "u13-w5.mp3",
   "text": "sosirile",
   "rate": "-10%"
  },
  {
   "file": "u13-s.mp3",
   "text": "Trenul sosește la ora zece.",
   "rate": "+0%"
  },
  {
   "file": "u13-s-slow.mp3",
   "text": "Trenul sosește la ora zece.",
   "rate": "-35%"
  },
  {
   "file": "u13-t.mp3",
   "text": "Sosiri. Londra, paisprezece și douăzeci, a sosit. Paris, cincisprezece și cinci, întârziere. Roma, cincisprezece și patruzeci, la timp.",
   "rate": "-5%"
  },
  {
   "file": "u14-w1.mp3",
   "text": "a cânta",
   "rate": "-10%"
  },
  {
   "file": "u14-w2.mp3",
   "text": "cântec",
   "rate": "-10%"
  },
  {
   "file": "u14-w3.mp3",
   "text": "cântăreț",
   "rate": "-10%"
  },
  {
   "file": "u14-w4.mp3",
   "text": "cântăreață",
   "rate": "-10%"
  },
  {
   "file": "u14-w5.mp3",
   "text": "încântat",
   "rate": "-10%"
  },
  {
   "file": "u14-s.mp3",
   "text": "Încântat de cunoștință!",
   "rate": "+0%"
  },
  {
   "file": "u14-s-slow.mp3",
   "text": "Încântat de cunoștință!",
   "rate": "-35%"
  },
  {
   "file": "u14-t.mp3",
   "text": "Concert în parc. Cântece populare românești. Sâmbătă, ora nouăsprezece. Intrarea liberă.",
   "rate": "-5%"
  },
  {
   "file": "u15-w1.mp3",
   "text": "a plăti",
   "rate": "-10%"
  },
  {
   "file": "u15-w2.mp3",
   "text": "plată",
   "rate": "-10%"
  },
  {
   "file": "u15-w3.mp3",
   "text": "plătit",
   "rate": "-10%"
  },
  {
   "file": "u15-w4.mp3",
   "text": "neplătit",
   "rate": "-10%"
  },
  {
   "file": "u15-w5.mp3",
   "text": "plătitor",
   "rate": "-10%"
  },
  {
   "file": "u15-s.mp3",
   "text": "Pot să plătesc cu cardul?",
   "rate": "+0%"
  },
  {
   "file": "u15-s-slow.mp3",
   "text": "Pot să plătesc cu cardul?",
   "rate": "-35%"
  },
  {
   "file": "u15-t.mp3",
   "text": "Casa trei. Plata cu cardul sau numerar. Vă rugăm să păstrați bonul!",
   "rate": "-5%"
  },
  {
