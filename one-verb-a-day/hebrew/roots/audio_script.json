  {
   "file": "u2-w5.mp3",
   "text": "לִמּוּדִים",
   "rate": "-10%"
  },
  {
   "file": "u2-s.mp3",
   "text": "הַתַּלְמִידָה לוֹמֶדֶת עִבְרִית.",
   "rate": "+0%"
  },
  {
   "file": "u2-s-slow.mp3",
   "text": "הַתַּלְמִידָה לוֹמֶדֶת עִבְרִית.",
   "rate": "-35%"
  },
  {
   "file": "u2-t.mp3",
   "text": "הורים יקרים, מחר התלמידים לומדים בספרייה. המורה מבקשת להביא מחברת ועט.",
   "rate": "-5%"
