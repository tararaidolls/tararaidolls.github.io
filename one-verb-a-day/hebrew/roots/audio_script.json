  {
   "file": "u7-s.mp3",
   "text": "אִמָּא קוֹנָה לֶחֶם וְחָלָב.",
   "rate": "+0%"
  },
  {
   "file": "u7-s-slow.mp3",
   "text": "אִמָּא קוֹנָה לֶחֶם וְחָלָב.",
   "rate": "-35%"
  },
  {
   "file": "u7-t.mp3",
   "text": "מִבְצָע בַּקַּנְיוֹן! קְנוּ שְׁנַיִם, קַבְּלוּ אֶחָד חִנָּם. רַק הַיּוֹם.",
