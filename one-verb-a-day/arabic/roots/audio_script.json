   "rate": "-10%"
  },
  {
   "file": "u3-w3.mp3",
   "text": "عَامِل",
   "rate": "-10%"
  },
  {
   "file": "u3-w4.mp3",
   "text": "مَعْمَل",
   "rate": "-10%"
  },
  {
   "file": "u3-w5.mp3",
   "text": "أَعْمَال",
   "rate": "-10%"
  },
  {
   "file": "u3-s.mp3",
   "text": "أَبِي يَعْمَلُ فِي مُسْتَشْفًى.",
   "rate": "+0%"
  },
  {
   "file": "u3-s-slow.mp3",
   "text": "أَبِي يَعْمَلُ فِي مُسْتَشْفًى.",
   "rate": "-35%"
  },
  {
   "file": "u3-t.mp3",
   "text": "مطلوب عمال لمقهى! العمل صباحا أو مساء. الخبرة ليست ضرورية.",
   "rate": "-5%"
  },
  {
   "file": "u4-w1.mp3",
   "text": "طَعَام",
   "rate": "-10%"
  },
  {
   "file": "u4-w2.mp3",
   "text": "مَطْعَم",
   "rate": "-10%"
  },
  {
   "file": "u4-w3.mp3",
   "text": "طَعْم",
   "rate": "-10%"
  },
  {
   "file": "u4-w4.mp3",
   "text": "أَطْعَمَ",
   "rate": "-10%"
  },
  {
   "file": "u4-w5.mp3",
   "text": "مَطَاعِم",
   "rate": "-10%"
  },
  {
   "file": "u4-s.mp3",
   "text": "الطَّعَامُ فِي هَذَا الْمَطْعَمِ لَذِيذٌ.",
   "rate": "+0%"
  },
  {
   "file": "u4-s-slow.mp3",
   "text": "الطَّعَامُ فِي هَذَا الْمَطْعَمِ لَذِيذٌ.",
   "rate": "-35%"
  },
  {
   "file": "u4-t.mp3",
   "text": "مطعم السوق. طعام بيتي. الغداء من الساعة الثانية عشرة حتى الرابعة. طبق اليوم: شكشوكة.",
   "rate": "-5%"
  },
  {
   "file": "u5-w1.mp3",
   "text": "فَتَحَ",
   "rate": "-10%"
  },
  {
   "file": "u5-w2.mp3",
   "text": "مَفْتُوح",
   "rate": "-10%"
  },
  {
   "file": "u5-w3.mp3",
   "text": "مِفْتَاح",
   "rate": "-10%"
  },
  {
   "file": "u5-w4.mp3",
   "text": "فَتْح",
   "rate": "-10%"
  },
  {
   "file": "u5-w5.mp3",
   "text": "افْتِتَاح",
   "rate": "-10%"
  },
  {
   "file": "u5-s.mp3",
   "text": "الْمَتْجَرُ مَفْتُوحٌ حَتَّى السَّاعَةِ السَّابِعَةِ.",
   "rate": "+0%"
  },
  {
   "file": "u5-s-slow.mp3",
   "text": "الْمَتْجَرُ مَفْتُوحٌ حَتَّى السَّاعَةِ السَّابِعَةِ.",
   "rate": "-35%"
  },
  {
   "file": "u5-t.mp3",
   "text": "مفتوح. من السبت إلى الخميس، من الساعة التاسعة حتى السابعة مساء. الجمعة: مغلق. المفتاح عند الجار.",
   "rate": "-5%"
  },
  {
   "file": "u6-w1.mp3",
   "text": "خَرَجَ",
   "rate": "-10%"
  },
  {
   "file": "u6-w2.mp3",
   "text": "مَخْرَج",
   "rate": "-10%"
  },
  {
   "file": "u6-w3.mp3",
   "text": "خُرُوج",
   "rate": "-10%"
  },
  {
   "file": "u6-w4.mp3",
   "text": "خَارِج",
   "rate": "-10%"
  },
  {
   "file": "u6-w5.mp3",
   "text": "تَخَرَّجَ",
   "rate": "-10%"
  },
  {
   "file": "u6-s.mp3",
   "text": "أَيْنَ الْمَخْرَجُ، مِنْ فَضْلِكَ؟",
   "rate": "+0%"
  },
  {
   "file": "u6-s-slow.mp3",
   "text": "أَيْنَ الْمَخْرَجُ، مِنْ فَضْلِكَ؟",
   "rate": "-35%"
  },
  {
   "file": "u6-t.mp3",
   "text": "مدخل المترو. مخرج رقم اثنين: إلى السوق. مخرج الطوارئ.",
   "rate": "-5%"
  },
  {
   "file": "u7-w1.mp3",
   "text": "سَافَرَ",
   "rate": "-10%"
  },
  {
   "file": "u7-w2.mp3",
   "text": "سَفَر",
   "rate": "-10%"
  },
  {
   "file": "u7-w3.mp3",
   "text": "مُسَافِر",
   "rate": "-10%"
  },
  {
   "file": "u7-w4.mp3",
   "text": "سَفَارَة",
   "rate": "-10%"
  },
  {
   "file": "u7-w5.mp3",
   "text": "سَفِير",
   "rate": "-10%"
  },
  {
   "file": "u7-s.mp3",
   "text": "سَنُسَافِرُ إِلَى دُبَيّ غَدًا.",
   "rate": "+0%"
  },
  {
   "file": "u7-s-slow.mp3",
   "text": "سَنُسَافِرُ إِلَى دُبَيّ غَدًا.",
   "rate": "-35%"
  },
  {
   "file": "u7-t.mp3",
   "text": "المغادرة. الرحلة إلى دبي، الساعة العاشرة والنصف. البوابة رقم خمسة. على المسافرين التوجه إلى البوابة.",
   "rate": "-5%"
  },
  {
   "file": "u8-w1.mp3",
   "text": "عَلِمَ",
   "rate": "-10%"
  },
  {
   "file": "u8-w2.mp3",
   "text": "عِلْم",
   "rate": "-10%"
  },
  {
   "file": "u8-w3.mp3",
