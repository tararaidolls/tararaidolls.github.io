   "rate": "-10%"
  },
  {
   "file": "u8-w4.mp3",
   "text": "عَالِم",
   "rate": "-10%"
  },
  {
   "file": "u8-w5.mp3",
   "text": "مَعْلُومَات",
   "rate": "-10%"
  },
  {
   "file": "u8-s.mp3",
   "text": "الْمُعَلِّمُ يَشْرَحُ الدَّرْسَ.",
   "rate": "+0%"
  },
  {
   "file": "u8-s-slow.mp3",
   "text": "الْمُعَلِّمُ يَشْرَحُ الدَّرْسَ.",
   "rate": "-35%"
  },
  {
   "file": "u8-t.mp3",
   "text": "مركز العلوم. معرض جديد: عالم الفضاء. معلومات: عند المدخل.",
