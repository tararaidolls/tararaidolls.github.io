   "text": "مَدْرَسَة",
   "rate": "-10%"
  },
  {
   "file": "u2-w4.mp3",
   "text": "مُدَرِّس",
   "rate": "-10%"
  },
  {
   "file": "u2-w5.mp3",
   "text": "دِرَاسَة",
   "rate": "-10%"
  },
  {
   "file": "u2-s.mp3",
   "text": "يَدْرُسُ أَخِي فِي الْمَدْرَسَةِ.",
   "rate": "+0%"
  },
  {
   "file": "u2-s-slow.mp3",
   "text": "يَدْرُسُ أَخِي فِي الْمَدْرَسَةِ.",
   "rate": "-35%"
  },
  {
   "file": "u2-t.mp3",
   "text": "أولياء الأمور الكرام، غدا يدرس الطلاب في المكتبة. يرجى إحضار دفتر وقلم.",
   "rate": "-5%"
  },
  {
   "file": "u3-w1.mp3",
   "text": "عَمِلَ",
   "rate": "-10%"
  },
  {
   "file": "u3-w2.mp3",
