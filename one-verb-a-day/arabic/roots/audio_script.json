   "rate": "-10%"
  },
  {
   "file": "u1-s.mp3",
   "text": "أَنَا أَكْتُبُ رِسَالَةً لِجَدَّتِي.",
   "rate": "+0%"
  },
  {
   "file": "u1-s-slow.mp3",
   "text": "أَنَا أَكْتُبُ رِسَالَةً لِجَدَّتِي.",
   "rate": "-35%"
  },
  {
   "file": "u1-t.mp3",
   "text": "مرحبا! أمس كتبت لك رسالة، لكني نسيت أن أرسلها. سأرسلها غدا. ما عنوانك الجديد؟",
   "rate": "-5%"
  },
  {
   "file": "u2-w1.mp3",
   "text": "دَرَسَ",
   "rate": "-10%"
  },
  {
